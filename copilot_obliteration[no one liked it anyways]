            Remove-Item -Path $Path -Recurse -Force
            Log "  >> DELETED."
        } catch {
            Write-Host "  !! Deletion Failed: $_" -ForegroundColor Red
        }
    }
} else {
    Log "  >> No physical Copilot folders found."
}

# === PHASE 2: APPX PACKAGE ANNIHILATION ===
