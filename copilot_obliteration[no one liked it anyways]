$WindowsApps = "$env:ProgramFiles\WindowsApps"
# We use ErrorAction SilentlyContinue for Get-ChildItem only to avoid spamming "Access Denied" on non-related folders
# The actual deletion logic is Strict.
$CopilotFolders = Get-ChildItem $WindowsApps -Recurse -Filter "*Copilot*" -Directory -ErrorAction SilentlyContinue
$CopilotFolders += Get-ChildItem $WindowsApps -Recurse -Filter "*BingChat*" -Directory -ErrorAction SilentlyContinue

if ($CopilotFolders) {
    foreach ($Folder in $CopilotFolders) {
        $Path = $Folder.FullName
        Log "  >> DETECTED: $Path"
