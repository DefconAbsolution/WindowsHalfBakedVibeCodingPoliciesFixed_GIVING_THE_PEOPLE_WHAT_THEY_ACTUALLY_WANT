}

function Log {
    param ($msg)
    $timestamp = (Get-Date).ToString("HH:mm:ss")
    # FORCE RED TEXT FOR EVERYTHING
    Write-Host "[$timestamp] $msg" -ForegroundColor Red
    if ($logEnabled) { Add-Content -Path $logPath -Value "[$timestamp] $msg" -ErrorAction Continue }
}

# === HELPER: THE PERMISSION CRUSHER ===
function Take-Ownership {
    param($Target)
    if (Test-Path $Target) {
        Log "  >> Seizing Ownership: $Target"
        try {
            Start-Process "takeown" -ArgumentList "/f `"$Target`" /a" -NoNewWindow -Wait
            Start-Process "icacls" -ArgumentList "`"$Target`" /grant Administrators:F /c" -NoNewWindow -Wait
        } catch {
            Write-Host "  !! Ownership Seizure Failed: $_" -ForegroundColor Red
        }
    }
}

# === HELPER: THE REGISTRY TOMBSTONE ===
function Tombstone-RegistryKey {
    param($KeyPath)
    Log "TOMBSTONING KEY: $KeyPath"
    
    if (Test-Path $KeyPath) { 
        try {
            Remove-Item -Path $KeyPath -Recurse -Force
        } catch {
            Write-Host "  !! Key Deletion Failed: $_" -ForegroundColor Red
        }
    }
    
    try {
        New-Item -Path $KeyPath -Force | Out-Null
        $acl = Get-Acl $KeyPath
        $deny = New-Object System.Security.AccessControl.RegistryAccessRule("Everyone", "FullControl", "ContainerInherit,ObjectInherit", "None", "Deny")
        $acl.AddAccessRule($deny)
        Set-Acl -Path $KeyPath -AclObject $acl
        Log "  >> ACL Lock Applied."
    } catch { 
        Write-Host "  !! ACL Lock Failed: $_" -ForegroundColor Red
    }
}

# === PHASE 1: PHYSICAL BINARY DESTRUCTION ===
