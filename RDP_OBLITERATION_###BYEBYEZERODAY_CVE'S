#Requires -RunAsAdministrator
# DEFCON ABSOLUTION: RDP OBLITERATION V4 (BLACK HOLE)
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Continue' # ERRORS WILL BE DISPLAYED.

Write-Host "🔥 DEFCON ABSOLUTION: RDP OBLITERATION INITIATED 🔥" -ForegroundColor Red

# === LOGGING SETUP ===
$useLog = Read-Host "Enable logging to C:\DefconAbsolution\KILL SCRIPTS\rdp_kill_verbose.log ? (y/n)"
$DoLog = $useLog -match '^[Yy]'

$LogRoot = "C:\DefconAbsolution\KILL SCRIPTS"
$LogFile = Join-Path $LogRoot "rdp_kill_verbose.log"

if ($DoLog -and !(Test-Path $LogRoot)) {
    try { New-Item -ItemType Directory -Force -Path $LogRoot | Out-Null } catch { Write-Host "Log dir creation failed." -ForegroundColor Red }
}

function Log {
    param([string]$msg)
    $timestamp = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
    $line = "$timestamp :: $msg"
    Write-Host $line -ForegroundColor Red
    if ($DoLog) {
        try { $line | Out-File -FilePath $LogFile -Append -Encoding UTF8 -ErrorAction Continue } catch {}
    }
}

function Take-Ownership {
    param($Target)
    if (Test-Path $Target) {
        Log "  >> Seizing Ownership: $Target"
        Start-Process "takeown" -ArgumentList "/f `"$Target`" /a" -NoNewWindow -Wait
        Start-Process "icacls" -ArgumentList "`"$Target`" /grant Administrators:F /c" -NoNewWindow -Wait
    }
}

Log "===== DEFCONABSOLUTION RDP OBLITERATION V4 INITIATED ====="

# PHASE 1: KERNEL SERVICE DELETION
Log "PHASE 1: KERNEL SERVICE DELETION"
$RdpServices = @(
    "TermService",      # Remote Desktop Services
    "SessionEnv",       # Remote Desktop Configuration
    "UmRdpService",     # Remote Desktop Services UserMode Port Redirector
    "tapisrv"           # Telephony (Required for RDP Dial-in)
)

foreach ($Service in $RdpServices) {
    Log "TERMINATING SERVICE: $Service"
    try {
        Stop-Service -Name $Service -Force
        Log "  >> Service Stopped."
    } catch {
        Write-Host "  !! Stop Failed: $_" -ForegroundColor Red
    }

    Log "DELETING SERVICE ENTRY: $Service"
    try {
        $proc = Start-Process "sc.exe" -ArgumentList "delete $Service" -NoNewWindow -Wait -PassThru
        if ($proc.ExitCode -ne 0) { Write-Host "  !! SC DELETE Exit Code: $($proc.ExitCode)" -ForegroundColor Red }
    } catch {
        Write-Host "  !! SC DELETE Failed: $_" -ForegroundColor Red
    }
}

# PHASE 2: REGISTRY ANNIHILATION
Log "PHASE 2: REGISTRY ANNIHILATION"
$RegTargets = @(
    "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server",
    "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services",
    "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Terminal Server"
)

foreach ($RegKey in $RegTargets) {
    if (Test-Path $RegKey) {
        Log "WIPING REGISTRY TREE: $RegKey"
        try {
            Remove-Item -Path $RegKey -Recurse -Force
        } catch {
            Write-Host "  !! Registry Delete Failed: $_" -ForegroundColor Red
        }
    }
}

# PHASE 3: BINARY DESTRUCTION (File System)
Log "PHASE 3: BINARY DESTRUCTION"
$Binaries = @(
    "$env:SystemRoot\System32\termsrv.dll",        # The RDP Server DLL
    "$env:SystemRoot\System32\mstsc.exe",          # The RDP Client
    "$env:SystemRoot\System32\mstscax.dll",        # RDP ActiveX
    "$env:SystemRoot\System32\drivers\termdd.sys", # Terminal Server Driver
    "$env:SystemRoot\System32\rdpclip.exe"         # Clipboard Monitor
)

foreach ($File in $Binaries) {
    if (Test-Path $File) {
        Take-Ownership -Target $File
        Log "DELETING FILE: $File"
        try {
            Remove-Item -Path $File -Force
        } catch {
            Write-Host "  !! File Delete Failed: $_" -ForegroundColor Red
        }
    } else {
        Log "File already missing: $File"
    }
}

# PHASE 4: FIREWALL LOCKDOWN
Log "PHASE 4: FIREWALL LOCKDOWN"
$fwRules = @(
    @{ Name="BLOCK-RDP-TCP-IN"; Direction="Inbound"; Protocol="TCP"; Port=3389 },
    @{ Name="BLOCK-RDP-TCP-OUT"; Direction="Outbound"; Protocol="TCP"; Port=3389 },
    @{ Name="BLOCK-RDP-UDP-IN"; Direction="Inbound"; Protocol="UDP"; Port=3389 },
    @{ Name="BLOCK-RDP-UDP-OUT"; Direction="Outbound"; Protocol="UDP"; Port=3389 }
)

foreach ($rule in $fwRules) {
    Log "FIREWALL: Creating Block Rule $($rule.Name)"
    try {
        New-NetFirewallRule -DisplayName $rule.Name -Direction $rule.Direction -Protocol $rule.Protocol -LocalPort $rule.Port -Action Block | Out-Null
    } catch {
        Write-Host "  !! Firewall Rule Failed: $_" -ForegroundColor Red
    }
}

# PHASE 5: GROUP PURGE
Log "PHASE 5: GROUP PURGE"
Log "DELETING GROUP: Remote Desktop Users"
try {
    $Group = [ADSI]"WinNT://$env:COMPUTERNAME/Remote Desktop Users,group"
    $Group.DeleteObject() 
    Log "Group Deleted."
} catch {
    Write-Host "  !! Group deletion failed (Already gone?): $_" -ForegroundColor Red
}

# PHASE 6: LISTENER PORT NULLIFICATION
Log "PHASE 6: LISTENER PORT NULLIFICATION"
$RDPKey = "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp"
if (-not (Test-Path $RDPKey)) { 
    Log "Creating Dummy RDP Key to trap port..."
    try { New-Item -Path $RDPKey -Force | Out-Null } catch {}
}
Log "Setting PortNumber to 0 (Null)"
try {
    Set-ItemProperty -Path $RDPKey -Name "PortNumber" -Value 0 -Type DWord -Force
} catch {
    Write-Host "  !! Port Nullification Failed: $_" -ForegroundColor Red
}

Log "===== OBLITERATION COMPLETE. REBOOT REQUIRED. ====="
