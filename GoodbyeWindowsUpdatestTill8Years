#Requires -RunAsAdministrator
# DEFCON ABSOLUTION: UPDATE POLICY - 8 YEAR PAUSE
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Continue' # ERRORS WILL BE DISPLAYED.

Write-Host "🔥 SYSTEM ALERT: CONFIGURING UPDATE FREEDOM PROTOCOL. 🔥" -ForegroundColor Red

# === LOGGING SETUP ===
$LogPath = "$env:SystemDrive\DefconAbsolution_UpdateUnlock_Log.txt"
function Log {
    param ($msg)
    $timestamp = (Get-Date).ToString("HH:mm:ss")
    Write-Host "[$timestamp] $msg" -ForegroundColor Red
    try { Add-Content -Path $LogPath -Value "[$timestamp] $msg" -ErrorAction Continue } catch { Write-Host "Log write failed." -ForegroundColor Red }
}

# === PHASE 1: EXTEND PAUSE LIMIT (8 YEARS) ===
Log "PHASE 1: EXTENDING PAUSE LIMIT TO 3000 DAYS (8 YEARS)"
$UXSettings = "HKLM:\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings"

if (-not (Test-Path $UXSettings)) {
    try { 
        New-Item -Path $UXSettings -Force | Out-Null 
    } catch { 
        Write-Host "  !! Failed to create UX key: $_" -ForegroundColor Red 
    }
}

try {
    # 3000 Days = Approx 8.2 Years
    Set-ItemProperty -Path $UXSettings -Name "FlightSettingsMaxPauseDays" -Value 3000 -Type DWord -Force
    Log "  >> Pause Limit Extended to 3000 Days."
} catch {
    Write-Host "  !! FAILED to set pause limit: $_" -ForegroundColor Red
}

# === PHASE 2: REMOVE VERSION LOCKS ===
Log "PHASE 2: REMOVING VERSION TARGET LOCKS"
$WUPolicy = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate"

if (Test-Path $WUPolicy) {
    $Locks = @("TargetReleaseVersion", "TargetReleaseVersionInfo", "ProductVersion")
    
    foreach ($Lock in $Locks) {
        try {
            Remove-ItemProperty -Path $WUPolicy -Name $Lock -ErrorAction Stop
            Log "  >> REMOVED LOCK: $Lock"
        } catch {
            if ($_.Exception.Message -match "doesn't exist") {
                Log "  >> Lock '$Lock' was not present."
            } else {
                Write-Host "  !! FAILED to remove '$Lock': $_" -ForegroundColor Red
            }
        }
    }
} else {
    Log "  >> WindowsUpdate Policy key not found. System is already unlocked."
}

# === PHASE 3: ENSURE DRIVERS ARE ALLOWED ===
Log "PHASE 3: VERIFYING DRIVER/SECURITY ACCESS"
try {
    # Ensure we didn't accidentally block drivers in a previous script
    Set-ItemProperty -Path $WUPolicy -Name "ExcludeWUDriversInQualityUpdate" -Value 0 -Type DWord -Force
    Log "  >> Drivers Allowed."
} catch {
    # Key might not exist if policy folder is missing
    Write-Host "  !! Could not set Driver policy (Key missing?): $_" -ForegroundColor Red
}

# === PHASE 4: RESTART UPDATE SERVICE ===
Log "PHASE 4: RESTARTING UPDATE ENGINE"
try {
    Stop-Service -Name "wuauserv" -Force
    Start-Sleep -Seconds 2
    Start-Service -Name "wuauserv"
    Log "  >> Windows Update Service Restarted."
} catch {
    Write-Host "  !! SERVICE RESTART FAILED: $_" -ForegroundColor Red
}

Log "✅ OPERATION COMPLETE."
Write-Host "You can now go to Settings > Windows Update > Pause Updates and select up to 150+ weeks." -ForegroundColor Red
