#Requires -RunAsAdministrator
# DEFCON ABSOLUTION: ONEDRIVE BLACK HOLE (NO RETURN)
# Refined Edition - Strict Mode
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Continue'

Write-Host "🔥 BLACK HOLE PROTOCOL: ONEDRIVE EXTERMINATION INITIATED 🔥" -ForegroundColor Red

# === LOGGING SETUP ===
$logChoice = Read-Host "Create destruction log? (Y/N)"
$logEnabled = $false
$logPath = "$env:USERPROFILE\Desktop\OneDrive_BlackHole_Log.txt"

if ($logChoice -match "^[Yy]") {
    New-Item -Path $logPath -ItemType File -Force | Out-Null
    $logEnabled = $true
    Write-Host "🔍 Logging active: $logPath" -ForegroundColor Red
}

function Log {
    param ($msg)
    $timestamp = (Get-Date).ToString("HH:mm:ss")
    # FORCE RED TEXT FOR EVERYTHING
    Write-Host "[$timestamp] $msg" -ForegroundColor Red
    if ($logEnabled) { Add-Content -Path $logPath -Value "[$timestamp] $msg" -ErrorAction Continue }
}

# === HELPER: THE REGISTRY TOMBSTONE ===
# Deletes a key, recreates it empty, and sets DENY permissions.
function Tombstone-RegistryKey {
    param($KeyPath)
    Log "TOMBSTONING KEY: $KeyPath"
    
    # 1. Delete if exists
    if (Test-Path $KeyPath) { 
        try {
            Remove-Item -Path $KeyPath -Recurse -Force 
        } catch {
            Write-Host "  !! Key Deletion Failed: $_" -ForegroundColor Red
        }
    }
    
    # 2. Create empty key & Lock
    try {
        New-Item -Path $KeyPath -Force | Out-Null
        $acl = Get-Acl $KeyPath
        $deny = New-Object System.Security.AccessControl.RegistryAccessRule("Everyone", "FullControl", "ContainerInherit,ObjectInherit", "None", "Deny")
        $acl.AddAccessRule($deny)
        Set-Acl -Path $KeyPath -AclObject $acl
        Log "  >> ACL Lock Applied."
    } catch { 
        Write-Host "  !! ACL Lock Failed: $_" -ForegroundColor Red
    }
}

# === PHASE 1: PROCESS KILL (NO MERCY) ===
Log "PHASE 1: KILLING PROCESSES"
$Targets = @("OneDrive", "explorer", "FileCoAuth")
foreach ($T in $Targets) {
    try {
        Get-Process -Name $T -ErrorAction Stop | Stop-Process -Force
        Log "  >> Killed: $T"
    } catch {
        Write-Host "  >> Process $T not running or could not be killed: $_" -ForegroundColor Red
    }
}

# === PHASE 2: STANDARD UNINSTALL (ATTEMPT) ===
Log "PHASE 2: STANDARD UNINSTALL"
$sysWOW = "$env:SystemRoot\SysWOW64\OneDriveSetup.exe"
$sys32  = "$env:SystemRoot\System32\OneDriveSetup.exe"

if (Test-Path $sysWOW) {
    Log "  >> Running SysWOW64 Uninstaller..."
    try { Start-Process -FilePath $sysWOW -ArgumentList "/uninstall" -Wait -NoNewWindow } catch { Write-Host "  !! Uninstall Error: $_" -ForegroundColor Red }
} elseif (Test-Path $sys32) {
    Log "  >> Running System32 Uninstaller..."
    try { Start-Process -FilePath $sys32 -ArgumentList "/uninstall" -Wait -NoNewWindow } catch { Write-Host "  !! Uninstall Error: $_" -ForegroundColor Red }
} else {
    Log "  >> Uninstaller not found (Already gone?)"
}

# === PHASE 3: FILESYSTEM SHREDDING ===
Log "PHASE 3: FILESYSTEM SHREDDING"
$Folders = @(
    "$env:LOCALAPPDATA\Microsoft\OneDrive",
    "$env:ProgramData\Microsoft OneDrive",
    "$env:USERPROFILE\OneDrive",
    "$env:APPDATA\Microsoft\OneDrive",
    "$env:SystemDrive\OneDriveTemp",
    "$env:LOCALAPPDATA\OneDrive"
)

foreach ($F in $Folders) {
    if (Test-Path $F) {
        Log "  >> SHREDDING: $F"
        try {
            Remove-Item -Path $F -Recurse -Force
        } catch {
            Write-Host "  !! FAILED TO DELETE $F : $_" -ForegroundColor Red
        }
    }
}

# === PHASE 4: ENVIRONMENT VARIABLE SCRUB ===
Log "PHASE 4: ENVIRONMENT VARIABLE PURGE"
try {
    [Environment]::SetEnvironmentVariable("OneDrive", $null, "User")
    [Environment]::SetEnvironmentVariable("OneDriveConsumer", $null, "User")
    [Environment]::SetEnvironmentVariable("OneDrive", $null, "Machine")
} catch {
    Write-Host "  !! Env Var Scrub Error: $_" -ForegroundColor Red
}

# === PHASE 5: REGISTRY TOMBSTONING (ACL LOCKS) ===
Log "PHASE 5: REGISTRY BLACK HOLE (ACL LOCKS)"
$RegKeys = @(
    "HKLM:\SOFTWARE\Policies\Microsoft\Windows\OneDrive",
    "HKCU:\SOFTWARE\Microsoft\OneDrive",
    "HKLM:\SOFTWARE\Microsoft\OneDrive",
    "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run\OneDrive",
    "HKLM:\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Run\OneDrive"
)

foreach ($rk in $RegKeys) {
    Tombstone-RegistryKey -KeyPath $rk
}

# === PHASE 6: NAMESPACE & CLSID ANNIHILATION ===
Log "PHASE 6: REMOVING EXPLORER ICONS (CLSID)"
# This is the specific CLSID for the OneDrive Folder in Explorer
$OneDriveCLSID = "{018D5C66-4533-4307-9B53-224DE2ED1FE6}"

$CLSIDPaths = @(
    "HKCR:\CLSID\$OneDriveCLSID",
    "HKCR:\Wow6432Node\CLSID\$OneDriveCLSID",
    "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Desktop\NameSpace\$OneDriveCLSID",
    "HKCU:\Software\Classes\CLSID\$OneDriveCLSID"
)

foreach ($cp in $CLSIDPaths) {
    if (Test-Path $cp) {
        Log "  >> DELETING CLSID: $cp"
        try {
            Remove-Item -Path $cp -Recurse -Force
        } catch {
            Write-Host "  !! CLSID Deletion Failed: $_" -ForegroundColor Red
        }
    }
}

# Remove from the Navigation Pane specifically
$NavKey = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\FolderDescriptions\{A52BBA46-E9E1-435f-B3D9-28DAA648C0F6}"
if (Test-Path $NavKey) {
    try {
        Set-ItemProperty -Path $NavKey -Name "System.IsPinnedToNameSpaceTree" -Value 0 -Type DWord -Force
        Log "  >> Unpinned from Namespace Tree."
    } catch {
        Write-Host "  !! Failed to unpin from Namespace: $_" -ForegroundColor Red
    }
}

# === PHASE 7: DISABLE FILE SYNC PROVIDERS ===
Log "PHASE 7: DISABLING CLOUD SYNC ENGINES"
$SyncKeys = @(
    "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\FileSyncHandlers\$OneDriveCLSID",
    "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\SyncRootManager\OneDrive"
)
foreach ($sk in $SyncKeys) {
    if (Test-Path $sk) { 
        try {
            Remove-Item -Path $sk -Recurse -Force 
            Log "  >> Sync Provider Removed: $sk"
        } catch {
            Write-Host "  !! Failed to remove Sync Provider: $_" -ForegroundColor Red
        }
    }
}

# === PHASE 8: POLICY HARDENING ===
Log "PHASE 8: POLICY ENFORCEMENT"
$PolicyPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\OneDrive"
if (-not (Test-Path $PolicyPath)) { 
    try { New-Item -Path $PolicyPath -Force | Out-Null } catch { Write-Host "  !! Failed to create Policy Key: $_" -ForegroundColor Red }
}

try {
    Set-ItemProperty -Path $PolicyPath -Name "DisableFileSyncNGSC" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path $PolicyPath -Name "DisableFileSync" -Value 1 -Type DWord -Force
    Set-ItemProperty -Path $PolicyPath -Name "PreventNetworkTrafficPreUserSignIn" -Value 1 -Type DWord -Force
    Log "  >> Policies Enforced."
} catch {
    Write-Host "  !! Policy Enforcement Failed: $_" -ForegroundColor Red
}

# === PHASE 9: RESTART EXPLORER ===
Log "PHASE 9: RESTARTING EXPLORER"
Start-Process explorer.exe

Log "✅ BLACK HOLE ESTABLISHED. ONEDRIVE FILES SHREDDED. REGISTRY LOCKED."
Write-Host "💀 OneDrive is gone. Registry keys are now Read-Only to System. 💀" -ForegroundColor Red
